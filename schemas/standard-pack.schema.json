{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gu-corp.github.io/docs-lint/schemas/standard-pack.schema.json",
  "title": "docs-lint Document Standard Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "profiles", "documentTypes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "defaultProfile": { "type": "string" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "documentTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/documentType" }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "title": { "$ref": "#/$defs/localizedText" },
          "required": { "type": "boolean" }
        }
      }
    },
    "terminology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preferred", "variants"],
        "properties": {
          "preferred": { "type": "string", "minLength": 1 },
          "variants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "locale": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": { "pattern": "/" },
      "additionalProperties": { "$ref": "#/$defs/ruleSetting" }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructions": { "type": "array", "items": { "type": "string" } },
        "reviewInstructions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "required": { "type": "boolean" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "documentType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "template"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "template": { "type": "string", "minLength": 1 },
        "suggestedPath": { "type": "string" },
        "canonicalLocale": { "type": "string" },
        "variables": { "type": "object", "additionalProperties": { "$ref": "#/$defs/variable" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "extends": { "type": "array", "items": { "type": "string" } },
        "documentTypes": { "type": "array", "items": { "type": "string" } },
        "requiredDocuments": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "object", "additionalProperties": { "type": "string" } },
        "rules": {
          "type": "object",
          "propertyNames": { "pattern": "/" },
          "additionalProperties": { "$ref": "#/$defs/ruleSetting" }
        }
      }
    },
    "severity": {
      "enum": ["off", "info", "warning", "error"]
    },
    "ruleSetting": {
      "oneOf": [
        { "$ref": "#/$defs/severity" },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["severity"] },
            { "required": ["options"] }
          ],
          "properties": {
            "severity": { "$ref": "#/$defs/severity" },
            "options": { "type": "object" }
          }
        }
      ]
    }
  }
}
