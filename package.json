{
  "name": "@gu-corp/docs-lint",
  "version": "3.2.0",
  "description": "Standard Pack based documentation validation and authoring toolkit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor-runtime": {
      "types": "./dist/node/editor-session.d.ts",
      "import": "./dist/editor-runtime.mjs"
    },
    "./schemas/docs-lint": "./schemas/docs-lint-v3.schema.json",
    "./schemas/standard-pack": "./schemas/standard-pack.schema.json"
  },
  "bin": {
    "docs-lint": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs && tsc && node ./scripts/postbuild.mjs && node ./scripts/build-editor-runtime.mjs",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run --dir src",
    "prepublishOnly": "npm run check && npm test && npm run smoke",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "documentation",
    "lint",
    "markdown",
    "mdx",
    "requirements",
    "standard-pack"
  ],
  "author": "G.U.Corp",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rolldown": "^1.2.6",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "packs",
    "schemas",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gu-corp/docs-lint.git"
  },
  "private": true
}
