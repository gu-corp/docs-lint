{
  "$schema": "./schemas/docs-lint-v3.schema.json",
  "schemaVersion": 3,
  "root": "./docs",
  "include": ["**/*.md", "**/*.mdx"],
  "exclude": ["**/node_modules/**", "**/99-archive/**"],
  "rules": {
    "links/internal": "error",
    "markdown/headings": "warning",
    "markdown/code-fence-language": "warning",
    "content/terminology": "warning",
    "structure/standard-pack": "off",
    "document/required-sections": "off",
    "traceability/requirements-tests": "off"
  }
}
